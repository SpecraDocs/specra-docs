# Environment Configuration for Production
# Copy this file and rename it to .env.production
# Fill in all required values before deployment

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
APP_PORT=3000
APP_URL=https://docs.specra.com

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=specra
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=specra_docs
POSTGRES_PORT=5432

# Full database URL (used by Prisma)
DATABASE_URL=postgresql://specra:CHANGE_ME_STRONG_PASSWORD@postgres:5432/specra_docs?schema=public

# ============================================
# Authentication (Auth.js)
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_RANDOM_SECRET_KEY
AUTH_URL=https://docs.specra.com

# GitHub OAuth (for admin access)
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# ============================================
# Stripe Configuration
# ============================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_PROFESSIONAL_PRICE_ID=price_professional_monthly
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# ============================================
# M-Pesa Configuration (optional)
# ============================================
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_business_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://docs.specra.com/api/payments/mpesa/callback

# ============================================
# Email Configuration (optional)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@specra.com

# ============================================
# Analytics & Monitoring (optional)
# ============================================
PUBLIC_GA_ID=G-XXXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn

# ============================================
# Feature Flags
# ============================================
ENABLE_PAYMENTS=true
ENABLE_ORGANIZATIONS=true
ENABLE_MPESA=false

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# ============================================
# Security
# ============================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY
