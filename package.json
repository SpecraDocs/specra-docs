{
  "name": "specra-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run seed-admin && next dev",
    "build": "npm run generate:redirects && NEXT_BUILD_MODE=default next build",
    "build:export": "npm run generate:redirects && NEXT_BUILD_MODE=export next build && npm run generate:static-redirects",
    "start": "npm run seed-admin && next start",
    "lint": "eslint .",
    "generate:redirects": "node scripts/generate-redirects.mjs",
    "generate:static-redirects": "node scripts/generate-static-redirects.mjs",
    "index:search": "tsx scripts/index-search.ts",
    "test:search": "tsx scripts/test-search.ts",
    "seed-admin": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@octokit/app": "^16.1.2",
    "@octokit/webhooks": "^14.2.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@stripe/stripe-js": "^8.7.0",
    "bcryptjs": "^3.0.3",
    "dockerode": "^4.0.9",
    "dotenv": "^17.2.4",
    "geoip-lite": "^1.4.10",
    "lucide-react": "^0.454.0",
    "next": "^16.1.0",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.18.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "specra": "0.1.11",
    "stripe": "^20.3.1",
    "tar": "^7.5.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^3.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "prisma": "^7.3.0",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
