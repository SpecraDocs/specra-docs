generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Required Models ────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts            Account[]
  sessions            Session[]
  subscriptions       Subscription[]
  payments            Payment[]
  organizationMembers OrganizationMember[]
  projects            Project[]
  apiTokens           ApiToken[]
  auditLogs           AuditLog[]
  billingAddress      BillingAddress?
  invoices            Invoice[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Billing Models ─────────────────────────────────────────────────────────

model Plan {
  id                     String  @id @default(cuid())
  name                   String
  slug                   String  @unique
  stripePriceIdMonthly   String?
  stripePriceIdAnnual    String?
  priceUsd               Int     // cents
  priceUsdAnnual         Int?    // cents per month when billed annually
  priceKes               Int     // KES
  priceKesAnnual         Int?    // KES per month when billed annually
  features               Json    @default("{}")
  active                 Boolean @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  stripeSubscriptionId String?
  stripeCustomerId     String?
  status               SubscriptionStatus @default(ACTIVE)
  paymentProvider      PaymentProvider    @default(STRIPE)
  interval             BillingInterval    @default(MONTHLY)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  grantedBy            String?
  grantReason          String?
  extraSeats              Int      @default(0)
  stripeExtraSeatItemId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model Payment {
  id             String          @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Int             // smallest currency unit
  currency       Currency        @default(USD)
  provider       PaymentProvider @default(STRIPE)
  providerTxId   String?
  status         PaymentStatus   @default(PENDING)
  couponCode     String?
  taxAmount      Int?

  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice?

  @@index([userId])
  @@index([providerTxId])
}

// ─── Coupon, Billing & Invoice Models ───────────────────────────────────────

model Coupon {
  id                   String     @id @default(cuid())
  code                 String     @unique
  type                 CouponType
  value                Int        // percentage (0-100) or fixed amount in smallest currency unit
  currency             Currency?  // required for FIXED type
  maxUses              Int?
  currentUses          Int        @default(0)
  expiresAt            DateTime?
  active               Boolean    @default(true)
  applicablePlans      String[]   // plan slugs, empty = all plans
  stripeCouponId       String?
  stripePromotionCodeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillingAddress {
  id         String  @id @default(cuid())
  userId     String  @unique
  address    String
  city       String
  state      String?
  country    String
  postalCode String?
  taxPin     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  userId         String
  paymentId      String   @unique
  subtotal       Int
  discount       Int      @default(0)
  taxAmount      Int      @default(0)
  taxRate        Float    @default(0)
  total          Int
  currency       Currency @default(USD)
  couponCode     String?
  billingAddress Json?    // snapshot of billing address at time of invoice
  taxPin         String?
  pdfUrl         String?
  sentAt         DateTime?

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([userId])
}

model TaxConfig {
  id      String  @id @default(cuid())
  country String  @unique
  rate    Float   // e.g., 0.16 for 16%
  name    String  // e.g., "VAT", "Sales Tax"
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Organization Models ────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  invitations OrgInvitation[]
  projects    Project[]
  auditLogs   AuditLog[]
}

model OrganizationMember {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model OrgInvitation {
  id        String           @id @default(cuid())
  orgId     String
  email     String
  role      OrgRole          @default(MEMBER)
  token     String           @unique @default(cuid())
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

// ─── Project & Deployment Models ────────────────────────────────────────────

model Project {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  subdomain      String   @unique
  customDomain   String?  @unique
  userId         String
  orgId          String?
  githubRepo     String?
  githubBranch   String?  @default("main")
  githubInstallId Int?
  web3formsKey   String?
  chatEnabled    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  deployments     Deployment[]
  analyticsEvents AnalyticsEvent[]
  conversations   ChatConversation[]

  @@index([userId])
  @@index([orgId])
}

model Deployment {
  id          String           @id @default(cuid())
  projectId   String
  status      DeploymentStatus @default(QUEUED)
  containerId String?
  port        Int?
  buildLogs   String?          @db.Text
  trigger     DeployTrigger    @default(MANUAL)
  commitSha   String?
  archivePath String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// ─── Analytics Models ───────────────────────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(cuid())
  projectId   String
  sessionId   String
  path        String
  referrer    String?
  browser     String?
  os          String?
  device      String?
  country     String?
  region      String?
  city        String?
  ipHash      String?
  scrollDepth Int?
  duration    Int?     // seconds
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, sessionId])
  @@index([projectId, path])
}

// ─── API & Audit Models ────────────────────────────────────────────────────

model ApiToken {
  id        String    @id @default(cuid())
  userId    String
  name      String
  tokenHash String    @unique
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  orgId     String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orgId])
  @@index([createdAt])
}

// ─── Chat Models ────────────────────────────────────────────────────────────

model ChatConversation {
  id           String     @id @default(cuid())
  projectId    String
  visitorId    String
  visitorName  String?
  visitorEmail String?
  status       ChatStatus @default(OPEN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model ChatMessage {
  id             String         @id @default(cuid())
  conversationId String
  senderType     ChatSenderType
  senderId       String?
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Doc Visitor Models ─────────────────────────────────────────────────────

model DocVisitor {
  id                String   @id @default(cuid())
  email             String
  name              String?
  image             String?
  provider          String   // "google" | "github"
  providerAccountId String
  createdAt         DateTime @default(now())
  lastLoginAt       DateTime @default(now())

  pageAccesses DocPageAccess[]

  @@unique([provider, providerAccountId])
  @@index([email])
}

model DocPageAccess {
  id           String   @id @default(cuid())
  docVisitorId String
  projectId    String
  path         String
  version      String
  createdAt    DateTime @default(now())

  visitor DocVisitor @relation(fields: [docVisitorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([docVisitorId])
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  RUNNING
  STOPPED
  FAILED
}

enum DeployTrigger {
  MANUAL
  CLI
  GITHUB
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum PaymentProvider {
  STRIPE
  MPESA
  ADMIN
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum Currency {
  USD
  KES
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ChatStatus {
  OPEN
  CLOSED
}

enum ChatSenderType {
  VISITOR
  OWNER
}
